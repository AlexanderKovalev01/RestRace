FROM ubuntu:latest

RUN apt-get update && apt-get install -y \
    git \
    zip \
    curl \
    nano \
    && rm -rf /var/lib/apt/lists/*

# Install JDK 25.0.2 from Adoptium
RUN curl -fL "https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.2%2B10/OpenJDK25U-jdk_x64_linux_hotspot_25.0.2_10.tar.gz" \
    -o /tmp/jdk25.tar.gz \
    && mkdir -p /opt/java \
    && tar -xzf /tmp/jdk25.tar.gz -C /opt/java --strip-components=1 \
    && rm /tmp/jdk25.tar.gz

ENV JAVA_HOME=/opt/java
ENV PATH=$JAVA_HOME/bin:$PATH

# Install Maven from Ubuntu repository (стабильная версия)
RUN apt-get update && apt-get install -y maven \
    && rm -rf /var/lib/apt/lists/*

ENV MAVEN_HOME=/usr/share/maven
ENV PATH=$MAVEN_HOME/bin:$PATH

# Install Tomcat 11
RUN curl -fL "https://downloads.apache.org/tomcat/tomcat-11/v11.0.22/bin/apache-tomcat-11.0.22.tar.gz" \
    -o /tmp/tomcat.tar.gz \
    && mkdir -p /opt/tomcat \
    && tar -xzf /tmp/tomcat.tar.gz -C /opt/tomcat --strip-components=1 \
    && rm /tmp/tomcat.tar.gz

ENV CATALINA_HOME=/opt/tomcat
ENV PATH=$CATALINA_HOME/bin:$PATH

# Install WildFly 39
RUN curl -fL "https://github.com/wildfly/wildfly/releases/download/39.0.1.Final/wildfly-39.0.1.Final.tar.gz" \
    -o /tmp/wildfly.tar.gz \
    && mkdir -p /opt/wildfly \
    && tar -xzf /tmp/wildfly.tar.gz -C /opt/wildfly --strip-components=1 \
    && rm /tmp/wildfly.tar.gz

ENV WILDFLY_HOME=/opt/wildfly
ENV PATH=$WILDFLY_HOME/bin:$PATH

RUN mkdir -p /home/projects

WORKDIR /home/projects

CMD ["/bin/bash"]